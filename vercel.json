{
  "functions": {
    "api/script/[slug].js": { "includeFiles": "index.html" },
    "api/game.js": { "includeFiles": "index.html" },
    "api/scripts.js": { "includeFiles": "{dist/index.html,index.html}", "maxDuration": 15 },
    "api/ai-chat.js": { "maxDuration": 30 },
    "api/push.js": { "maxDuration": 20 },
    "api/ice.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/s/:game/script/:slug", "destination": "/api/script/:slug?game=:game" },
    { "source": "/script/:slug", "destination": "/api/script/:slug" },
    { "source": "/s/:game", "destination": "/api/game?game=:game" },

    { "source": "/:view(feed|videos|rewards|quiz|ai|wallet|review|trending|newest|views|rated|verified|keyless|fav|community|cscripts|chat|games|upload|guide|legal|account|settings|about|donate|admin)", "destination": "/api/scripts?fn=page&view=:view" },

    { "source": "/api/all-scripts", "destination": "/api/scripts?fn=list" },
    { "source": "/api/script-detail", "destination": "/api/scripts?fn=detail" },

    {
      "source": "/((?!api|google42c8f0419ec3cfec\\.html|privacy\\.html|favicon\\.ico|manifest\\.json|sw\\.js|.*\\.(?:png|jpg|jpeg|svg|webp|gif|css|js|json|woff|woff2|ttf|eot)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
