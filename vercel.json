{
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "/api/scriptblox?path=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/s/id/:game",
      "destination": "/s/index.html"
    },
    {
      "source": "/s/en/:game",
      "destination": "/s/index.html"
    },
    {
      "source": "/s/:game",
      "destination": "/s/index.html"
    }
  ]
}
