{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/s/id/(.*)",
      "destination": "/s/index.html"
    },
    {
      "source": "/s/en/(.*)",
      "destination": "/s/index.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/s/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
