{
  "functions": {
    "api/script/[slug].js": { "includeFiles": "index.html" },
    "api/game.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/s/:game/script/:slug", "destination": "/api/script/:slug?game=:game" },
    { "source": "/script/:slug", "destination": "/api/script/:slug" },
    { "source": "/s/:game", "destination": "/api/game?game=:game" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/guard",
      "schedule": "0 */6 * * *"
    }
  ]
}
